@{
    ViewData["Title"] = "Chương trình Khuyến Mãi";
}

<div class="container mt-5 mb-5" style="min-height: 60vh;">
    <h2 class="fw-bold text-danger mb-4 text-uppercase">Chương Trình Khuyến Mãi</h2>
    
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <span class="badge bg-danger mb-3" style="width: fit-content;">HOT</span>
                <h4 class="fw-bold text-dark">Giảm 50% Xả Kho Cuối Ngày</h4>
                <p class="text-muted">Áp dụng cho các sản phẩm thức ăn nhanh chuẩn bị hết hạn trong ngày. Mua ngay để tiết kiệm chi phí nhưng vẫn đảm bảo chất lượng an toàn thực phẩm!</p>
                <div class="mt-auto pt-3">
                    <a href="/SanPham" class="btn btn-warning fw-bold px-4">Đến Mua Ngay</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <span class="badge bg-primary mb-3" style="width: fit-content;">COMBO MỚI</span>
                <h4 class="fw-bold text-dark">Bữa Sáng Tiết Kiệm 20.000đ</h4>
                <p class="text-muted">Khởi đầu ngày mới tràn đầy năng lượng. Combo bao gồm 1 Bánh Mì Que Hải Phòng giòn rụm và 1 Cà Phê Bạc Xỉu / Nước Suối.</p>
                <div class="mt-auto pt-3">
                    <a href="/SanPham" class="btn btn-outline-primary fw-bold px-4">Xem Menu</a>
                </div>
            </div>
        </div>
    </div>
</div>