@{
    ViewData["Title"] = "Liên Hệ & Góp Ý";
}

<div class="container mt-5 mb-5" style="min-height: 60vh;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white">
                <h2 class="fw-bold text-primary mb-3 text-center">GỬI GÓP Ý</h2>
                <p class="text-muted text-center mb-4">Chúng tôi luôn lắng nghe để cải thiện chất lượng dịch vụ.</p>
                
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên của bạn</label>
                        <input type="text" class="form-control bg-light" placeholder="Nhập tên đầy đủ...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email hoặc Số điện thoại</label>
                        <input type="text" class="form-control bg-light" placeholder="Để chúng tôi có thể liên hệ lại...">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Nội dung góp ý / Than phiền</label>
                        <textarea class="form-control bg-light" rows="4" placeholder="Vui lòng nhập chi tiết nội dung bạn muốn gửi đến quản lý MiniStop..."></textarea>
                    </div>
                    <button type="button" class="btn btn-primary fw-bold w-100 py-3 rounded-3" onclick="alert('Cảm ơn bạn! Thông tin góp ý đã được ghi nhận vào hệ thống.')">
                        Gửi Phản Hồi Ngay
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>