@{
    ViewData["Title"] = "Thanh toán MoMo - MiniStop";
    Layout = null; // Tắt layout mặc định để làm giao diện full màn hình giống cổng thanh toán thật
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cổng thanh toán MoMo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background-color: #f2f2f2; font-family: Arial, sans-serif; }
        .momo-box { background: #fff; max-width: 500px; margin: 50px auto; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .momo-header { background-color: #a50064; color: white; padding: 15px 20px; text-align: center; }
        .qr-code-box { border: 2px dashed #a50064; padding: 20px; border-radius: 12px; margin: 20px auto; width: 250px; text-align: center; }
    </style>
</head>
<body>

    <div class="momo-box">
        <div class="momo-header">
            <h4 class="mb-0 fw-bold">Cổng Thanh Toán MoMo</h4>
        </div>
        <div class="p-4 text-center">
            <h6 class="text-muted mb-2">Mã đơn hàng: <strong class="text-dark">@ViewBag.MaHD</strong></h6>
            <h4 class="fw-bold text-danger mb-4">Số tiền: @string.Format("{0:N0}", ViewBag.TongTien) VNĐ</h4>

            <div class="qr-code-box">
                <img src="https://upload.wikimedia.org/wikipedia/commons/d/d0/QR_code_for_mobile_English_Wikipedia.svg" width="100%" alt="QR Code">
            </div>

            <p class="small text-muted mb-4"><i class="fa-solid fa-mobile-screen me-1"></i> Mở ứng dụng MoMo và quét mã để thanh toán.</p>

            <form action="/GioHang/XacNhanMoMo" method="post">
                <input type="hidden" name="maHD" value="@ViewBag.MaHD" />
                <button type="submit" class="btn fw-bold text-white w-100 py-3 rounded-pill" style="background-color: #a50064; transition: 0.3s;">
                    <i class="fa-solid fa-circle-check me-2"></i> TÔI ĐÃ QUÉT MÃ THANH TOÁN
                </button>
            </form>
            
            <div class="mt-3">
                <a href="/" class="small text-muted text-decoration-none">Hủy giao dịch & Quay về trang chủ</a>
            </div>
        </div>
    </div>

</body>
</html>