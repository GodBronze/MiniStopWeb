@model IEnumerable<MiniStopWeb.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn - MiniStop";
}

<style>
    /* ================= HỆ MÀU THƯƠNG HIỆU ================= */
    :root {
        --ms-blue: #0033a0;
        --ms-yellow: #ffc107;
        --ms-red: #e31837;
        --ms-bg: #f8f9fa;
    }

    body {
        background-color: var(--ms-bg);
    }

    /* ================= KHUNG GIỎ HÀNG BÊN TRÁI ================= */
    .cart-container {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        overflow: hidden;
    }
    .cart-header {
        background-color: var(--ms-blue);
        color: #fff;
        padding: 16px 24px;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }
    .cart-item {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f3f7;
        transition: background-color 0.2s;
    }
    .cart-item:last-child {
        border-bottom: none;
    }
    .cart-item:hover {
        background-color: #fafbfc;
    }
    .cart-img {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #f4f6f9;
    }
    
    /* Nút tăng giảm số lượng */
    .qty-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid #ddd;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ms-blue);
        font-weight: bold;
        text-decoration: none;
        transition: 0.2s;
    }
    .qty-btn:hover {
        background: var(--ms-yellow);
        border-color: var(--ms-yellow);
        color: #000;
    }
    .qty-input {
        width: 40px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 700;
        color: #333;
    }

    /* Nút xóa */
    .btn-delete {
        color: #ccc;
        transition: 0.2s;
        background: transparent;
        border: none;
        font-size: 1.2rem;
    }
    .btn-delete:hover {
        color: var(--ms-red);
        transform: scale(1.1);
    }

    /* ================= KHUNG TÓM TẮT ĐƠN HÀNG BÊN PHẢI ================= */
    .summary-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        padding: 24px;
        position: sticky;
        top: 90px; /* Ghim cố định khi cuộn, tránh đè Navbar */
        border-top: 5px solid var(--ms-yellow);
    }
    .summary-title {
        font-weight: 800;
        color: var(--ms-blue);
        text-transform: uppercase;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px dashed #ddd;
    }
    .btn-checkout {
        background-color: var(--ms-yellow);
        color: var(--ms-blue);
        font-weight: 800;
        font-size: 1.1rem;
        padding: 12px;
        border-radius: 50px;
        border: none;
        width: 100%;
        transition: 0.3s;
        text-transform: uppercase;
    }
    .btn-checkout:hover {
        background-color: var(--ms-blue);
        color: var(--ms-yellow);
        box-shadow: 0 8px 15px rgba(0,51,160,0.2);
    }
</style>

<div class="container mt-4 mb-5">
    
    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold text-uppercase border-start border-5 border-warning ps-3 mb-0" style="color: var(--ms-blue);">
            🛒 Giỏ Hàng Của Bạn
        </h3>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 text-center bg-white p-5 rounded-4 shadow-sm">
                <img src="https://cdn-icons-png.flaticon.com/512/11329/11329060.png" style="width: 150px; opacity: 0.7;" class="mb-4" alt="Empty Cart">
                <h4 class="fw-bold text-dark mb-3">Giỏ hàng của bạn đang trống!</h4>
                <p class="text-muted mb-4">Có vẻ như bạn chưa chọn món ngon nào. Hãy khám phá thực đơn hấp dẫn của MiniStop nhé!</p>
                <a href="/SanPham/Index" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm" style="background-color: var(--ms-blue); border: none;">
                    <i class="fa-solid fa-utensils me-2"></i>Tiếp Tục Chọn Món
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="cart-container">
                    <div class="cart-header d-flex justify-content-between">
                        <span>Chi tiết món ăn</span>
                        <span>Số lượng sản phẩm: @Model.Sum(x => x.SoLuong)</span>
                    </div>

                    <div class="cart-body">
                        @foreach (var item in Model)
                        {
                            // Tự động gán ảnh tương tự logic ở trang Sản Phẩm
                            string nameLower = item.TenSp.ToLower();
                            string foodImage = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=200&q=80"; 

                            if (nameLower.Contains("bánh mì") || nameLower.Contains("que")) {
                                foodImage = "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=200&q=80";
                            } else if (nameLower.Contains("burger") || nameLower.Contains("bò")) {
                                foodImage = "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=200&q=80";
                            } else if (nameLower.Contains("cơm") || nameLower.Contains("nắm") || nameLower.Contains("sushi")) {
                                foodImage = "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?w=200&q=80";
                            } else if (nameLower.Contains("coca") || nameLower.Contains("nước") || nameLower.Contains("trà")) {
                                foodImage = "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?w=200&q=80";
                            }

                            <div class="cart-item d-flex align-items-center">
                                <img src="@foodImage" alt="@item.TenSp" class="cart-img me-3">
                                
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold text-dark mb-1">@item.TenSp</h5>
                                    <span class="text-muted small">Đơn giá: @string.Format("{0:N0}", item.DonGia) đ</span>
                                </div>

                                <div class="d-flex align-items-center mx-4 bg-light rounded-pill px-2 py-1 border">
                                    <a href="/GioHang/GiamSoLuong?id=@item.MaSp" class="qty-btn text-decoration-none">
                                        <i class="fa-solid fa-minus" style="font-size: 0.8rem;"></i>
                                    </a>
                                    <input type="text" class="qty-input" value="@item.SoLuong" readonly>
                                    <a href="/GioHang/TangSoLuong?id=@item.MaSp" class="qty-btn text-decoration-none">
                                        <i class="fa-solid fa-plus" style="font-size: 0.8rem;"></i>
                                    </a>
                                </div>

                                <div class="text-end me-4" style="min-width: 100px;">
                                    <h5 class="fw-bold mb-0" style="color: var(--ms-red);">@string.Format("{0:N0}", item.ThanhTien) đ</h5>
                                </div>

                                <a href="/GioHang/XoaKhoiGio?id=@item.MaSp" class="btn-delete" title="Xóa món này">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="summary-card">
                    <h4 class="summary-title"><i class="fa-solid fa-receipt me-2"></i>Hóa Đơn</h4>
                    
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Tạm tính (@Model.Sum(x => x.SoLuong) món)</span>
                        <span class="fw-bold text-dark">@string.Format("{0:N0}", Model.Sum(x => x.ThanhTien)) đ</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Phí giao hàng</span>
                        <span class="fst-italic text-muted" style="font-size: 0.9rem;">Sẽ tính khi thanh toán</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4 pt-3 border-top">
                        <span class="fs-5 fw-bold text-dark">Tổng cộng</span>
                        <span class="fs-4 fw-bold" style="color: var(--ms-red);">@string.Format("{0:N0}", Model.Sum(x => x.ThanhTien)) đ</span>
                    </div>

                    <button type="button" class="btn-checkout shadow-sm" onclick="XacNhanDatHang()">
                        ĐẶT HÀNG NGAY <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                    
                    <div class="text-center mt-3">
                        <a href="/SanPham/Index" class="text-decoration-none small fw-bold" style="color: var(--ms-blue);">
                            <i class="fa-solid fa-arrow-left me-1"></i> Mua thêm món khác
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function XacNhanDatHang() {
            Swal.fire({
                title: 'Xác nhận đặt hàng?',
                text: "Bạn đã kiểm tra kỹ các món ăn trong giỏ hàng chưa?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0033a0',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý, Đặt hàng!',
                cancelButtonText: 'Xem lại',
                customClass: {
                    confirmButton: 'fw-bold',
                    cancelButton: 'fw-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // 2. CHÚ Ý CHỖ NÀY: 
                    // Hiện tại nó đang trỏ về hàm ThanhToan trong GioHangController của bạn.
                    // Nếu bạn đã thiết kế một trang Giao diện thanh toán riêng (Ví dụ: /GioHang/TrangThanhToan), 
                    // hãy sửa lại đường link màu đỏ bên dưới cho khớp nhé!
                    window.location.href = '/GioHang/ThanhToan';
                }
            });
        }
    </script>
}