@{
    ViewData["Title"] = "Đặt hàng thành công - MiniStop";
}

<div class="container mt-5 mb-5 text-center" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <div class="p-5 bg-white rounded-4 shadow-sm" style="max-width: 600px; width: 100%;">
        <i class="fa-solid fa-circle-check text-success mb-3" style="font-size: 5rem;"></i>
        <h2 class="fw-bold text-dark">Giao Dịch Thành Công!</h2>
        
        <p class="text-muted mt-3 mb-4" style="font-size: 1.1rem;">
            @(TempData["ThongBao"] ?? "Cảm ơn bạn đã mua sắm tại MiniStop. Đơn hàng của bạn đang được xử lý và sẽ được giao trong thời gian sớm nhất!")
        </p>

        <a href="/" class="btn fw-bold text-white px-5 py-3 rounded-pill" style="background-color: #00b14f; transition: 0.3s;">
            <i class="fa-solid fa-house me-2"></i> TIẾP TỤC MUA SẮM
        </a>
    </div>
</div>