@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản - MiniStop";
}

<div class="container my-5">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg p-4 bg-white" style="border-radius: 24px; border-top: 6px solid #ffc107 !important;">
                
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-1" style="color: #0033a0;"><i class="fa-solid fa-store text-warning me-2"></i>MINISTOP</h2>
                    <p class="text-muted small">Chào mừng bạn quay trở lại với dịch vụ tiện lợi trực tuyến</p>
                </div>

                @if (ViewBag.Loi != null)
                {
                    <div class="alert alert-danger border-0 rounded-3 small p-2 text-center mb-3 animate shake" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Loi
                    </div>
                }

                <form action="/TaiKhoan/DangNhap" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Số điện thoại khách hàng</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 12px 0 0 12px;"><i class="fa-solid fa-phone"></i></span>
                            <input type="tel" name="sdt" class="form-control bg-light border-start-0 shadow-none" placeholder="Nhập số điện thoại..." required style="border-radius: 0 12px 12px 0; padding: 10px;">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Mật mã bảo mật</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 12px 0 0 12px;"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" name="matKhau" class="form-control bg-light border-start-0 shadow-none" placeholder="Nhập mật khẩu..." required style="border-radius: 0 12px 12px 0; padding: 10px;">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2.5 mb-3 shadow-sm text-uppercase" style="border-radius: 50px; color: #0033a0; font-size: 1rem; letter-spacing: 0.5px; transition: 0.3s;">
                        Đăng Nhập <i class="fa-solid fa-arrow-right-to-bracket ms-1"></i>
                    </button>
                </form>

                <div class="text-center mt-2">
                    <span class="text-muted small">Bạn chưa có tài khoản?</span>
                    <a href="/TaiKhoan/DangKy" class="text-decoration-none small fw-bold ms-1" style="color: #0033a0;">Đăng ký ngay</a>
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <a href="/Admin/DangNhap" class="text-secondary small text-decoration-none opacity-75 hover-opacity-100">
                        <i class="fa-solid fa-shield-halved me-1"></i>Khu vực dành cho Quản trị viên
                    </a>
                </div>
                
            </div>
        </div>
    </div>
</div>