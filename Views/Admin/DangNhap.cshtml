@{
    ViewData["Title"] = "Đăng Nhập Quản Trị Hệ Thống - MiniStop";
}

<style>
    body {
        background-color: #f0f2f5;
    }
    .admin-login-card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    .admin-header {
        background: linear-gradient(135deg, #001f5b, #0033a0);
        color: white;
        padding: 30px 20px;
        text-align: center;
        border-bottom: 4px solid #e31837; /* Viền đỏ quyền lực */
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card admin-login-card bg-white">
                
                <div class="admin-header">
                    <h3 class="fw-bold mb-0"><i class="fa-solid fa-server me-2 text-warning"></i>SYSTEM ADMIN</h3>
                    <p class="small text-white-50 mt-2 mb-0">Hệ Thống Quản Trị Cửa Hàng</p>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.Loi != null)
                    {
                        <div class="alert alert-danger border-0 rounded-3 small p-2 text-center mb-4" role="alert">
                            <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.Loi
                        </div>
                    }

                    <form action="/Admin/DangNhap" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Mã Nhân Viên</label>
                            <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden;">
                                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-id-badge text-muted"></i></span>
                                <input type="text" name="maNv" class="form-control bg-light border-0 shadow-none" placeholder="Ví dụ: NV001" required style="padding: 12px;">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary">Mật Khẩu Phân Quyền</label>
                            <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden;">
                                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-key text-muted"></i></span>
                                <input type="password" name="matKhau" class="form-control bg-light border-0 shadow-none" placeholder="••••••••" required style="padding: 12px;">
                            </div>
                        </div>

                        <button type="submit" class="btn w-100 fw-bold py-3 text-white mb-2" style="background-color: #e31837; border-radius: 12px; font-size: 1.05rem; transition: 0.3s;">
                            TRUY CẬP HỆ THỐNG <i class="fa-solid fa-fingerprint ms-1"></i>
                        </button>
                    </form>
                    
                    <div class="text-center mt-3">
                        <a href="/" class="text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại trang cửa hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>