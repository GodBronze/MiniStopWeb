@model IEnumerable<MiniStopWeb.Models.SanPham>
@using Microsoft.AspNetCore.Http
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Lý Sản Phẩm - MiniStop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
        .sidebar { width: 260px; height: 100vh; background: #212529; position: fixed; top: 0; left: 0; z-index: 1000; padding-top: 20px; }
        .sidebar a { color: #f8f9fa; padding: 14px 20px; display: block; text-decoration: none; font-weight: 600; }
        .sidebar a:hover, .sidebar a.active { background: #ffc107; color: #212529; transition: 0.3s; }
        .main-content { margin-left: 260px; padding: 30px; min-height: 100vh; }
        .header-box { background-color: #ffffff; padding: 20px; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
        .img-thumb { width: 45px; height: 45px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd; }
    </style>
</head>
<body>

    <div class="sidebar shadow">
        <div class="text-center mb-4">
            <h4 class="text-warning fw-bold">MINISTOP</h4>
            <span class="badge bg-danger">Quản Trị Viên</span>
        </div>
        <hr class="text-secondary">
        <a href="/Admin/Index">Đơn Hàng Cần Duyệt</a>
        <a href="/Admin/QuanLySanPham" class="active">Quản Lý Sản Phẩm</a>
        <a href="/AdminChat">Trực Tổng Đài (Chat)</a>
        <a href="#">Khách Hàng</a>
        <a href="/">Xem Cửa Hàng</a>
        <hr class="text-secondary">
        <div class="px-3 text-muted small mt-5">
            NV: @Context.Session.GetString("Admin_TenNV")
        </div>
    </div>

    <div class="main-content">
        
        <div class="header-box d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0 fw-bold text-dark text-uppercase">QUẢN LÝ DANH MỤC SẢN PHẨM</h4>
            <button type="button" class="btn btn-success fw-bold px-4" data-bs-toggle="modal" data-bs-target="#modalThemSP">
                THÊM MÓN MỚI
            </button>
        </div>

        @if (TempData["ThanhCongSP"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show fw-bold" role="alert">
                @TempData["ThanhCongSP"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["LoiSP"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show fw-bold" role="alert">
                @TempData["LoiSP"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Mã SP</th>
                                <th>Hình Ảnh</th>
                                <th>Tên Món Ăn / Thức Uống</th>
                                <th>Đơn Vị Tính</th>
                                <th class="text-end">Đơn Giá</th>
                                <th class="text-center">Số Lượng Tồn</th>
                                <th class="text-center">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string thumbImg = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100&q=80";
                                if (!string.IsNullOrEmpty(item.HinhAnh)) { 
                                    thumbImg = item.HinhAnh; 
                                }
                                else {
                                    string maSp = item.MaSp.Trim().ToUpper();
                                    string tenSp = item.TenSp.ToLower();
                                    if (maSp == "SP001" || tenSp.Contains("bánh mì que")) { thumbImg = "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=100&q=80"; }
                                    else if (maSp == "SP002" || tenSp.Contains("burger")) { thumbImg = "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100&q=80"; }
                                    else if (maSp == "SP003" || tenSp.Contains("cơm nắm")) { thumbImg = "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?w=100&q=80"; }
                                    else if (maSp == "SP004" || tenSp.Contains("coca")) { thumbImg = "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?w=100&q=80"; }
                                    else if (maSp == "SP005" || tenSp.Contains("trà sữa")) { thumbImg = "https://images.unsplash.com/photo-1558857563-b3773ed5d1f8?w=100&q=80"; }
                                    else if (maSp == "SP006" || tenSp.Contains("nước suối") || tenSp.Contains("aquafina")) { thumbImg = "https://images.unsplash.com/photo-1548839140-29a749e1bc4e?w=100&q=80"; }
                                    else if (maSp == "SP007" || tenSp.Contains("kem cây") || tenSp.Contains("cacao")) { thumbImg = "https://images.unsplash.com/photo-1580915411954-282cb1b0d780?w=100&q=80"; }
                                    else if (maSp == "SP008" || tenSp.Contains("sữa chua")) { thumbImg = "https://images.unsplash.com/photo-1571407970349-bc81e7e96d47?w=100&q=80"; }
                                    else if (maSp == "SP009" || tenSp.Contains("sừng bò")) { thumbImg = "https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=100&q=80"; }
                                    else if (maSp == "SP010" || tenSp.Contains("bông lan")) { thumbImg = "https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=100&q=80"; }
                                }

                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@item.MaSp.Trim()</td>
                                    <td><img src="@thumbImg" class="img-thumb shadow-sm" alt="@item.TenSp" /></td>
                                    <td class="fw-bold text-dark text-uppercase">@item.TenSp</td>
                                    <td><span class="badge bg-light text-dark border">@item.DonViTinh</span></td>
                                    <td class="fw-bold text-danger text-end">@item.DonGia?.ToString("N0") đ</td>
                                    <td class="text-center">
                                        <span class="badge @(item.SoLuong > 10 ? "bg-success" : "bg-warning") fw-bold">
                                            @item.SoLuong
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-warning fw-bold text-dark me-1 shadow-sm px-3" 
                                                onclick="moModalSua('@item.MaSp.Trim()', '@item.TenSp', '@item.DonViTinh', '@item.DonGia', '@item.SoLuong', '@(item.HinhAnh ?? "")')">
                                            Sửa
                                        </button>
                                        <a href="/Admin/XoaSanPham/@item.MaSp.Trim()" class="btn btn-sm btn-danger fw-bold shadow-sm px-3" 
                                           onclick="return confirm('Bạn chắc chắn có muốn xóa món ăn này khỏi thực đơn MiniStop?')">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL THÊM SẢN PHẨM MỚI -->
    <div class="modal fade" id="modalThemSP" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-success text-white rounded-top-4">
                    <h5 class="modal-title fw-bold">THÊM MÓN MỚI VÀO THỰC ĐƠN</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/Admin/ThemSanPham" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã sản phẩm</label>
                            <input type="text" name="MaSp" class="form-control" placeholder="Ví dụ: SP011" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên món ăn / đồ uống</label>
                            <input type="text" name="TenSp" class="form-control" placeholder="Nhập tên sản phẩm" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Hình ảnh sản phẩm (Link URL)</label>
                            <input type="text" name="HinhAnh" class="form-control" placeholder="VD: https://domain.com/anh-banh-mi.jpg" />
                            <div class="form-text small text-muted">Để trống nếu muốn hệ thống tự động gán ảnh theo tên món ăn.</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Đơn vị tính</label>
                                <input type="text" name="DonViTinh" class="form-control" placeholder="Ly, Cái, Hộp..." required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số lượng ban đầu</label>
                                <input type="number" name="SoLuong" class="form-control" value="50" min="0" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Đơn giá bán (VNĐ)</label>
                            <input type="number" name="DonGia" class="form-control" placeholder="Ví dụ: 25000" min="0" required />
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4">
                        <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">ĐÓNG</button>
                        <button type="submit" class="btn btn-success fw-bold px-4">LƯU THỰC ĐƠN</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL SỬA SẢN PHẨM -->
    <div class="modal fade" id="modalSuaSP" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-warning text-white rounded-top-4">
                    <h5 class="modal-title fw-bold">CẬP NHẬT THÔNG TIN MÓN</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/Admin/SuaSanPham" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Mã sản phẩm (Không cho phép sửa)</label>
                            <input type="text" id="edit_MaSp" name="MaSp" class="form-control bg-light fw-bold text-danger" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên món ăn / đồ uống</label>
                            <input type="text" id="edit_TenSp" name="TenSp" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Hình ảnh sản phẩm (Link URL)</label>
                            <input type="text" id="edit_HinhAnh" name="HinhAnh" class="form-control" placeholder="https://..." />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Đơn vị tính</label>
                                <input type="text" id="edit_DonViTinh" name="DonViTinh" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số lượng tồn kho</label>
                                <input type="number" id="edit_SoLuong" name="SoLuong" class="form-control" min="0" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Đơn giá bán (VNĐ)</label>
                            <input type="number" id="edit_DonGia" name="DonGia" class="form-control" min="0" required />
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4">
                        <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">HỦY</button>
                        <button type="submit" class="btn btn-warning fw-bold text-dark px-4">CẬP NHẬT NGAY</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function moModalSua(maSp, tenSp, dvt, gia, soluong, hinhanh) {
            document.getElementById('edit_MaSp').value = maSp;
            document.getElementById('edit_TenSp').value = tenSp;
            document.getElementById('edit_DonViTinh').value = dvt;
            document.getElementById('edit_DonGia').value = gia;
            document.getElementById('edit_SoLuong').value = soluong;
            document.getElementById('edit_HinhAnh').value = hinhanh;

            var modal = new bootstrap.Modal(document.getElementById('modalSuaSP'));
            modal.show();
        }
    </script>
</body>
</html>